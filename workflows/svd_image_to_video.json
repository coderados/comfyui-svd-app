{
  "name": "svd_image_to_video",
  "version": "1.0.0",
  "description": "ComfyUI workflow for Stable Video Diffusion image-to-video generation (unrestricted)",
  "workflow": {
    "3": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 576,
        "batch_size": 1
      },
      "unique_id": "3",
      "type": "latent"
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["10", 0]
      },
      "unique_id": "4",
      "type": "conditioning"
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["10", 0]
      },
      "unique_id": "5",
      "type": "conditioning"
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 42,
        "steps": 25,
        "cfg": 7.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0,
