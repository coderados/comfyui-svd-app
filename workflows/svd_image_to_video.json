  "node_definitions": {
    "StableVideoDiffusionSampler": {
      "output": "LATENT",
      "description": "SVD sampler node for image-to-video generation",
      "category": "SVD",
      "inputs": {
        "model": "MODEL",
        "latent": "LATENT",
        "seed": "INT",
        "steps": "INT",
        "cfg": "FLOAT",
        "motion_bucket_id": "INT",
        "fps": "INT",
