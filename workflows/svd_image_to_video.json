    "num_inference_steps": 25,
    "motion_bucket_id": 127,
    "fps": 7,
    "cfg": 7.0,
    "sampler": "euler",
    "scheduler": "normal",
    "resolution": [1024, 576],
    "disable_safety": true,
    "seed": 42
